{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/swift-format-lint.sh",
            "timeout": 60,
            "statusMessage": "Formatting + linting Swift…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(xcodegen generate*)",
      "Bash(swiftformat *)",
      "Bash(swiftlint *)",
      "Bash(xcodebuild -project ios/Venn.xcodeproj *)",
      "Bash(npm run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)"
    ]
  },
  "enabledMcpjsonServers": ["supabase"]
}
