# =============================================================================
# .gitignore — files that should never be committed to the repo.
# =============================================================================
# Everything listed here is either:
#   (a) generated automatically (build output, derived data) — never commit,
#   (b) machine-specific (OS cruft, editor settings) — never commit personal config,
#   (c) a secret (.env files, signing certs) — NEVER commit secrets to git. Ever.
# =============================================================================

# --- Xcode build & derived data ----------------------------------------------
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
xcuserdata/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# --- Generated Xcode project (regenerated by xcodegen) ----------------------
# We commit project.yml; the .xcodeproj is generated. Uncomment the next
# line if you want to commit the .xcodeproj as a fallback for new contributors.
ios/Venn.xcodeproj/

# --- Swift Package Manager ---------------------------------------------------
.build/
.swiftpm/
Packages/
Package.resolved
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# --- CocoaPods (not used, but ignore if anyone adds it later) ---------------
ios/Pods/
ios/Podfile.lock

# --- Generated config from .env ----------------------------------------------
# Built by the Xcode pre-build script from .env values. Never commit.
ios/Venn/Resources/GeneratedConfig.xcconfig

# --- Test results & coverage -------------------------------------------------
*.xcresult/
coverage/
*.profdata
*.profraw

# --- Node tooling (commitlint, prettier, husky) -----------------------------
node_modules/
npm-debug.log*

# --- Environment variables (SECRETS — NEVER COMMIT) -------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
# Commit .env.example as a template (no real values) — see docs/SETUP.md

# --- Code signing & provisioning (NEVER COMMIT) -----------------------------
*.mobileprovision
*.p12
*.p8
*.cer
*.certSigningRequest
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# --- IDE & editor files ------------------------------------------------------
.idea/
*.swp
*.swo
*~

# --- OS files ----------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Temporary files ---------------------------------------------------------
*.tmp
*.temp
.cache/

# --- Claude / AI tooling local state (do not commit) ------------------------
# memory/ is per-person Claude session memory — it can contain personal info
# (emails, names) and is meaningless to other machines. Keep it local.
.claude/local/
memory/
