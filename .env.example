# =============================================================================
# .env.example — template for environment variables.
# =============================================================================
# HOW TO USE:
#   1. Copy this file to `.env` in the same folder:    cp .env.example .env
#   2. Fill in the real values in `.env` (NEVER commit `.env` to git).
#   3. The Xcode build script reads `.env` and writes the values into
#      ios/Venn/Resources/GeneratedConfig.xcconfig at build time. Never
#      commit GeneratedConfig.xcconfig either — it contains real secrets.
#
# WHY this pattern? iOS app bundles ship everything to the user's device.
# Anything you embed in the binary should be considered public. Use values
# safe to expose (Supabase anon key, public DSNs). Anything that allows
# writes or admin operations stays server-side and is never put in here.
# =============================================================================

# --- Required ---------------------------------------------------------------

# Supabase — public URL and anon key (safe to expose to clients).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# App environment: "development" | "staging" | "production"
APP_ENV=development

# --- Optional (observability) -----------------------------------------------
# Leave blank in local dev unless you want errors/events landing in shared
# dashboards. The SDKs no-op cleanly when these are unset.

# Sentry DSN — get one at https://sentry.io/. Format:
#   https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_DSN=

# PostHog — get an API key at https://posthog.com/. The host defaults to
# PostHog Cloud (US). Use https://eu.i.posthog.com if you choose the EU region.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
