{
  "name": "venn",
  "version": "0.0.1",
  "private": true,
  "description": "Venn — native iOS app (Swift + SwiftUI). This package.json hosts only repo-wide hygiene tools (husky, commitlint, prettier).",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write '**/*.{md,json,yml,yaml}'",
    "format:check": "prettier --check '**/*.{md,json,yml,yaml}'",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:types": "node --env-file=.env scripts/gen-types.mjs",
    "db:seed": "node --env-file=.env scripts/seed-remote.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "supabase": "2.111.0"
  }
}
