# =============================================================================
# .env.local.example — template for web/.env.local.
# =============================================================================
# HOW TO USE:
#   1. Copy this file to `.env.local` in this folder: cp .env.local.example .env.local
#   2. Fill in the real values (NEVER commit `.env.local` to git).
#
# Same Supabase project as iOS — see the root .env.example for context on
# why these are safe to expose to the client (public URL + anon key only).
# NEXT_PUBLIC_* vars are bundled into the client JS bundle by Next.js.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
